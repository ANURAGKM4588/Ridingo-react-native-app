# ====================================================================
# Ridingo Client-Side Configuration Template (.env.example)
# NOTE: All variables prefixed with VITE_ are inlined into public client bundles.
# NEVER put private server secrets (API secrets, private keys, database passwords) here!
# ====================================================================

# 1. Google Maps Platform (Public Browser Key with HTTP Referrer Restrictions)
# Enable: Maps JavaScript API, Places API, Geocoding API, Routes API
# Restrict in Google Cloud Console: HTTP Referrers (*.ridingo.in/*, localhost:*)
VITE_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE

# 2. Google OAuth Client IDs (Public Client Identifiers for Google Sign-In)
VITE_GOOGLE_IOS_CLIENT_ID=YOUR_IOS_CLIENT_ID_HERE.apps.googleusercontent.com
VITE_GOOGLE_SERVER_CLIENT_ID=YOUR_SERVER_CLIENT_ID_HERE.apps.googleusercontent.com
VITE_GOOGLE_ANDROID_CLIENT_ID=YOUR_ANDROID_CLIENT_ID_HERE.apps.googleusercontent.com

# 3. Supabase Live Cloud Backend (Publishable Anon Key only)
# Access control is enforced via Row Level Security (RLS) in PostgreSQL.
# NEVER expose the Supabase service_role key here!
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your_anon_key_here

# 4. PhonePe Payment Gateway (Public Merchant Identifiers only)
# In production, payload signing and status verification MUST be routed through
# a secure backend server / Supabase Edge Function to protect the PhonePe Salt Key.
VITE_PHONEPE_MERCHANT_ID=PGTESTPAYUAT
VITE_PHONEPE_ENV=sandbox
VITE_PHONEPE_VPA=ridingo.phonepe@ybl

# 5. Firebase Identity Platform (Client Web Configuration)
# Restrict authorized domains in Firebase Console (Authentication -> Settings -> Authorized Domains)
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_WEB_API_KEY_HERE
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ====================================================================
# SERVER-SIDE SECRETS (Reference only - Keep on secure server / Supabase secrets)
# These must NEVER have a VITE_ prefix and must NEVER be placed in client code.
# ====================================================================
# RAZORPAY_KEY_ID=rzp_live_...
# RAZORPAY_KEY_SECRET=your_razorpay_secret_here
# PHONEPE_SALT_KEY=your_production_salt_key_here
# PHONEPE_SALT_INDEX=1
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
# FAST2SMS_API_KEY=your_fast2sms_key_here
# TWOFACTOR_API_KEY=your_2factor_key_here
